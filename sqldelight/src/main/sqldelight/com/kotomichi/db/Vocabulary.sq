package com.kotomichi.db

import com.kotomichi.db.TypeConverters

table Vocabulary {
    id INTEGER PRIMARY KEY,
    kanji TEXT NOT NULL,
    hiragana TEXT NOT NULL,
    romaji TEXT NOT NULL,
    meaning_indonesian TEXT NOT NULL,
    meaning_english TEXT,
    part_of_speech TEXT,
    jlpt_level TEXT,
    frequency_rank INTEGER,
    audio_url_kanji TEXT,
    audio_url_hiragana TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    last_synced INTEGER NOT NULL
}

create index idx_vocab_kanji on Vocabulary(kanji)
create index idx_vocab_hiragana on Vocabulary(hiragana)
create index idx_vocab_jlpt on Vocabulary(jlpt_level)

table Deck {
    id INTEGER PRIMARY KEY,
    title TEXT NOT NULL,
    description TEXT,
    jlpt_level TEXT NOT NULL,
    order_index INTEGER NOT NULL,
    is_published INTEGER NOT NULL DEFAULT 0,
    created_by TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    vocabulary_count INTEGER NOT NULL DEFAULT 0,
    mastery_percent REAL NOT NULL DEFAULT 0.0
}

create index idx_deck_published on Deck(is_published)
create index idx_deck_jlpt on Deck(jlpt_level)
create index idx_deck_order on Deck(order_index)

table DeckVocabulary {
    deck_id INTEGER NOT NULL,
    vocabulary_id INTEGER NOT NULL,
    order_in_deck INTEGER NOT NULL,
    PRIMARY KEY (deck_id, vocabulary_id)
}

create index idx_deck_vocab_deck on DeckVocabulary(deck_id)
create index idx_deck_vocab_vocab on DeckVocabulary(vocabulary_id)

table ExampleSentence {
    id INTEGER PRIMARY KEY,
    vocabulary_id INTEGER NOT NULL,
    japanese TEXT NOT NULL,
    indonesian TEXT NOT NULL,
    english TEXT,
    audio_url TEXT
}

create index idx_example_vocab on ExampleSentence(vocabulary_id)

table Collocation {
    id INTEGER PRIMARY KEY,
    vocabulary_id INTEGER NOT NULL,
    phrase TEXT NOT NULL,
    meaning TEXT NOT NULL,
    audio_url TEXT
}

create index idx_collocation_vocab on Collocation(vocabulary_id)