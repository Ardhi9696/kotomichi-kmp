<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="kotomichi.db" />
        <exclude domain="sharedpref" path="kotomichi_auth.xml" />
        <include domain="file" path="audio_cache/" />
