selectByUser:
SELECT *
FROM ReviewLog
WHERE user_id = :userId
ORDER BY reviewed_at DESC
LIMIT :limit OFFSET :offset;

selectByUserAndVocab:
SELECT *
FROM ReviewLog
WHERE user_id = :userId AND vocabulary_id = :vocabularyId
ORDER BY reviewed_at DESC;

selectById:
SELECT *
FROM ReviewLog
WHERE id = :id
LIMIT 1;

insertAndReturnId:
INSERT INTO ReviewLog (user_id, vocabulary_id, direction, is_new, correctness, elapsed_ms, rating, stability_before, stability_after, difficulty_before, difficulty_after, retrievability_before, reviewed_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
RETURNING id;

insertWithRemoteId:
INSERT OR REPLACE INTO ReviewLog (id, user_id, vocabulary_id, direction, is_new, correctness, elapsed_ms, rating, stability_before, stability_after, difficulty_before, difficulty_after, retrievability_before, reviewed_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectMaxId:
SELECT COALESCE(MAX(id), 0)
FROM ReviewLog
WHERE user_id = :userId;

selectExistsByIdentity:
SELECT COUNT(*)
FROM ReviewLog
WHERE user_id = :userId
  AND vocabulary_id = :vocabularyId
  AND direction = :direction
  AND reviewed_at / 1000 = :reviewedAtSeconds
  AND rating = :rating;